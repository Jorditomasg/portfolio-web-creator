# Build stage
FROM node:24-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# Production stage - Angular SSR server (also proxies /api and /uploads)
FROM node:24-alpine AS production

WORKDIR /app

COPY --from=builder /app/dist/frontend ./dist/frontend

ENV PORT=4200 BACKEND_URL=http://backend:3000

EXPOSE 4200

CMD ["node", "dist/frontend/server/server.mjs"]
